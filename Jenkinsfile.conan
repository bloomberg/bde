#!groovy

// ***************************************************************
// This is an internal Bloomberg Conan recipe.                   *
// This recipe does not work outside of Bloomberg infrastructure *
// ***************************************************************

library identifier: "conan-pipeline@main",
        retriever: modernSCM([
            $class: 'GitSCMSource',
            remote: "https://bbgithub.dev.bloomberg.com/conan/conan-pipeline",
            credentialsId: 'bbgithub_token'
    ])

jobInfo.failIfBranchIndexing()

String sourcePackage = 'bsl-internal'
List binaryPackages = [
    'libbbryu-dev',
    'libinteldfp-dev',
    'libpcre2-dev',
    'libbsl-dev',
    'libbdl-dev',
    'libs-baltst-dev',
    'libbal-dev',
    'libbbl-dev'
]

node('WINDOWS') {
    try {
        stage('Checkout') {
            dir("src") {
                sourceDir = pwd()
                checkout scm
            }
        }

        withConan { conan ->
            stage('Create package(s)') {
                String user = 'test'
                String channel = 'unstable'

                if (env.CHANGE_ID) {
                    user = 'pr'
                    channel = "pr-${env.CHANGE_ID}"
                }

                conan.excludeFromDistributionLock([sourcePackage] + binaryPackages)

                conan.getReleaseProfiles().each { profile ->
                    dir("build_${profile}") {
                        ([sourcePackage] + binaryPackages).each { name ->
                            Map args = [
                                name:    name,
                                user:    user,
                                channel: channel,
                                '-o:a':  '*:dependency_user_channel=test/unstable',
                                '-pr:h': profile,
                                '-of':   name,
                                path:    sourceDir
                            ]
                            conan.build(args.clone())
                            conan.exportPkg(args)
                        }
                    }
                }
            }
            stage('Publish package(s)') {
                Boolean dryRun = true

                if ((env.BRANCH_NAME ?: '').startsWith('releases/') && debian.isChangelogUpdated()) {
                    dryRun = false
                }

                conan.remoteBbConan { remote ->
                    ([sourcePackage] + binaryPackages).each { name -> remote.upload(dryRun: dryRun, pattern: name) }
                }
            }
        }
    }
    finally {
        deleteDir()
    }
}
